PORT=3000

# Optional anti-spam integrations for blog comments. Each is skipped when unset.

# Signs the hidden timestamp in the comment form. Any long random string.
# If unset, a random one is generated per process (tokens die on restart).
COMMENT_SECRET=

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile). Free.
# Cloudflare's always-pass test pair for local dev:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Akismet (https://akismet.com/developers/) — free "personal" plan.
AKISMET_KEY=
AKISMET_BLOG=https://jgon.net
